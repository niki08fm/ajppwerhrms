{
  "name": "@ajpwer/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "worker": "node --env-file-if-exists=../.env src/worker.js",
    "build": "prisma generate",
    "test": "vitest run",
    "test:engines": "vitest run tests/engines",
    "test:api": "vitest run tests/api",
    "test:load": "node --env-file-if-exists=../.env tests/load/budgets.js",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force --skip-seed",
    "db:seed": "node --env-file-if-exists=../.env prisma/seed.js",
    "db:seed:setup": "node --env-file-if-exists=../.env prisma/seed.js --setup-only",
    "db:import:employees": "node --env-file-if-exists=../.env scripts/import-employees.js",
    "db:seed:load": "node --env-file-if-exists=../.env prisma/seed-load.js",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "jobs:retention": "node --env-file-if-exists=../.env src/jobs/retention.js",
    "db:migration:new": "dotenv -e ../.env -- prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@ajpwer/face": "*",
    "@ajpwer/shared": "*",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "main": "src/server.js"
}
