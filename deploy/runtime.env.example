# Copy to /etc/ajpwer/runtime.env, mode 0600, owned by root.
# Replace EVERY CHANGE_ME; systemd loads this without a shell.
NODE_ENV=production
API_PORT=4000
WEB_ORIGIN=https://app.example.com
COOKIE_SECURE=true
# Keep host-only cookies. Vercel proxies /api to the AWS API origin.
COOKIE_DOMAIN=
TRUST_PROXY=1
# Neon pooled URL for runtime. Copy from Neon; retain its SSL parameters.
# URL-encode password special characters. Start with a small connection pool.
DATABASE_URL=postgresql://USER:CHANGE_ME@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=30
JWT_SECRET=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS
SITE_JWT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET
PII_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
FACE_SERVICE_URL=http://127.0.0.1:8100
FACE_SERVICE_TOKEN=CHANGE_ME_SHARED_RANDOM_SECRET
UPLOAD_DIR=/var/lib/ajpwer/uploads
EXPORT_DIR=/var/lib/ajpwer/exports
# Initial single-instance setup runs jobs inside the API. Do not configure Redis
# unless also configuring RUN_WORKER=true or a separate worker process.
REDIS_URL=
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_NAME=HR Admin
COMPANY_NAME=AJ Power Engineering
COMPANY_ADDRESS=
COMPANY_PAN=
COMPANY_TAN=
COMPANY_PF_CODE=
COMPANY_ESI_CODE=
NOMINATIM_EMAIL=CHANGE_ME_CONTACT_EMAIL
