# ─────────────────────────────────────────────────────────────────────────────
# AJPWER Workforce — environment configuration
#
# Copy this file to `.env` in the repository root and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port the API listens on
API_PORT=4000
# Public origin of the web app (used for CORS and cookies)
WEB_ORIGIN=http://localhost:5173
# Set to true when served over HTTPS (production). Makes cookies `Secure`.
COOKIE_SECURE=false
# Optional cookie domain, e.g. .ajpwer.in (leave blank for localhost)
COOKIE_DOMAIN=
# Trust X-Forwarded-For from this many proxies (1 behind nginx / a load balancer)
TRUST_PROXY=0

# ── PostgreSQL 16 ────────────────────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://ajpwer:CHANGE_ME@localhost:5432/ajpwer?schema=public
# Separate database used by the API integration tests (wiped on every run)
TEST_DATABASE_URL=postgresql://ajpwer:CHANGE_ME@localhost:5432/ajpwer_test?schema=public

# ── Redis (optional: job queue for payroll runs and large exports) ───────────
# Leave blank to run jobs inside the backend — fine for trying it out and for a
# small team. For production, install Redis and set e.g. redis://localhost:6379
REDIS_URL=

# ── Authentication ───────────────────────────────────────────────────────────
# Long random strings. Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SITE_JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING
# Admin session length in hours (sliding)
ADMIN_SESSION_HOURS=8
# Tablet session length in hours
SITE_SESSION_HOURS=24

# The single HR admin account created by `npm run db:seed`
ADMIN_EMAIL=hr@ajpwer.in
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=HR Admin

# ── Personal data encryption (PAN, Aadhaar, bank details) ────────────────────
# 32-byte key, base64 encoded. Generate with:  openssl rand -base64 32
# LOSING THIS KEY MAKES ENCRYPTED IDENTITY DATA UNREADABLE. Back it up separately.
PII_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# ── Company (seeded into the single `company` row) ───────────────────────────
COMPANY_NAME=AJ Power Engineering
COMPANY_ADDRESS=
COMPANY_PAN=
COMPANY_TAN=
COMPANY_PF_CODE=
COMPANY_ESI_CODE=

# ── Face service (face v2 — see face/INTEGRATION.md) ─────────────────────────
# The Python face service on this machine. Only the backend calls it; never
# expose port 8100 through nginx. Both are required: the backend will not start without them.
FACE_SERVICE_URL=http://127.0.0.1:8100
# Shared secret sent as X-Face-Token; the face service reads the same variable.
# Generate with:  openssl rand -hex 32
FACE_SERVICE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 1 = `npm run dev` also starts the face service (after `npm run face:install`)
FACE_SERVICE_DEV=0
# Optional thresholds (defaults shown). Tune them from the punch attempt log
# (Approvals → Punch attempts CSV) in the first weeks after go-live.
# SFace similarity (dot product of face codes) needed to recognise someone
# FACE_MATCH_MIN=0.4
# …and how far the best person must be ahead of the next one
# FACE_MATCH_MARGIN=0.05
# Live-face score (average of MiniFASNetV2 and V1SE "real") needed
# FACE_LIVE_MIN=0.7
# Head turn (degrees) between the straight and turned frame, the way asked
# FACE_TURN_MIN_DEG=15
# The straight and turned frames must be this similar (same person)
# FACE_SAME_PERSON_MIN=0.3
# Registration is refused when the face is this close to someone else's
# FACE_DUPLICATE_MIN=0.5
# A confirmed punch this sure (and live) adds a rolling template
# FACE_LEARN_MIN=0.55
# Rolling templates kept per person (registered ones are never trimmed)
# FACE_ROLLING_MAX=5
# Failed tries before the ID and name form
# FACE_MAX_TRIES=5
# Seconds to do the head turn, and to confirm "Is this you?"
# FACE_CHALLENGE_SECONDS=60
# FACE_CONFIRM_SECONDS=60
# Wait for the face service before telling the tablet to retry (ms)
# FACE_SERVICE_TIMEOUT_MS=8000
# Travel minutes counted for a Change site are capped at this
# FACE_TRAVEL_MAX_MIN=180
# Face service only: how long a request waits for the single worker before "busy" (ms)
# FACE_QUEUE_WAIT_MS=2000

# ── Attendance ───────────────────────────────────────────────────────────────
# GPS accuracy worse than this (metres) is rejected
GPS_MAX_ACCURACY_M=50
# Device clock difference that flags a punch (minutes)
CLOCK_SKEW_FLAG_MIN=5

# ── Site map: place search ───────────────────────────────────────────────────
# The site form's search box goes through the backend to OpenStreetMap's Nominatim
# (at most one request a second, answers cached 24 hours). Nominatim's usage
# policy requires a User-Agent naming the application and a contact email.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AJPWER-Workforce/1.0
NOMINATIM_EMAIL=it@ajpwer.in

# ── Files ────────────────────────────────────────────────────────────────────
# Where uploaded documents and gate snapshots are stored
UPLOAD_DIR=./uploads
# Where background exports are written
EXPORT_DIR=./exports

# ── Retention (days) ─────────────────────────────────────────────────────────
RETENTION_GATE_SNAPSHOT_DAYS=30
RETENTION_PUNCH_DAYS=1095
RETENTION_PAYROLL_YEARS=7
# The punch attempt log (for tuning face thresholds)
RETENTION_PUNCH_ATTEMPT_DAYS=365

# ── Web app (read by Vite; must start with VITE_) ────────────────────────────
# API base URL as seen from the browser. Leave as /api in dev (Vite proxies it).
VITE_API_URL=/api/v1
# Where the tablet loads its guidance model (Tiny Face Detector) from. It lives in
# face/models and the backend serves it at /face-models, so leave this as it is
# unless you host it somewhere else. Recognition runs in the face service, not the browser.
VITE_FACE_MODEL_URL=/face-models
