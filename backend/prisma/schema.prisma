// ─── Attendance ──────────────────────────────────────────────────────────────

/// APPEND-ONLY. No update, no delete (enforced by trigger and revoked grants).
/// work_date is set by the server in Asia/Kolkata, never by the device.
model Punch {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String         @db.Uuid
  employee          Employee       @relation(fields: [employee_id], references: [id])
  punched_at        DateTime       @db.Timestamptz(6)
  work_date         DateTime       @db.Date
  direction         PunchDirection
  site_id           String         @db.Uuid
  site              Site           @relation(fields: [site_id], references: [id])
  method            PunchMethod
  match_score       Decimal?       @db.Decimal(9, 6)
  /// Distance from the site centre — never a raw coordinate
  distance_m        Int?
  device_id         String?
  client_punched_at DateTime       @db.Timestamptz(6)
  /// Arrived more than an hour after it was taken (offline queue) or the device clock was off
  flagged           Boolean        @default(false)
  flag_reason       String?
  source_ref        String?
  /// The tablet punch session that made it — at most one punch per session
  session_id        String?        @unique @db.Uuid
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @db.Timestamptz(6)
  deleted_at        DateTime?      @db.Timestamptz(6)

  @@unique([employee_id, site_id, client_punched_at])
  @@index([employee_id, work_date])
  @@index([site_id, work_date])
  @@index([work_date])
  @@map("punch")
}

/// Layer 2: what a human decided. Stores what was computed alongside what was substituted.
model AttendanceOverride {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String         @db.Uuid
  employee          Employee       @relation(fields: [employee_id], references: [id])
  work_date         DateTime       @db.Date
  status            DayStatus
  day_value         Decimal        @db.Decimal(4, 2)
  worked_min        Int
  ot_min            Int
  late_min          Int
  /// HR's times for the day in minutes from midnight of the work date (out can pass 1440); null when HR marked the day instead
  in_min            Int?
  out_min           Int?
  reason_code       OverrideReason
  reason_text       String
  created_by        String
  computed_snapshot Json
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?      @db.Timestamptz(6)

  @@unique([employee_id, work_date])
  @@map("attendance_override")
}

model FaceException {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id             String              @db.Uuid
  site                Site                @relation(fields: [site_id], references: [id])
  occurred_at         DateTime            @db.Timestamptz(6)
  claimed_employee_id String?             @db.Uuid
  best_match_id       String?             @db.Uuid
  score               Decimal?            @db.Decimal(9, 6)
  reason              String
  direction           PunchDirection?
  distance_m          Int?
  /// Gate snapshot — deleted automatically after 30 days
  snapshot_key        String?
  /// NOT_RECOGNISED (the old tablet path), FAILED_TRIES (the ID/name form after the try limit)
  kind                String              @default("NOT_RECOGNISED")
  /// Aligned 112×112 face crops from the failed tries — deleted with the gate snapshots
  crop_keys           String[]            @default([])
  claimed_name        String?
  session_id          String?             @db.Uuid
  status              FaceExceptionStatus @default(PENDING)
  decided_by          String?
  decided_at          DateTime?           @db.Timestamptz(6)
  decision_reason     String?
  decided_employee_id String?             @db.Uuid
  punch_id            String?             @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?           @db.Timestamptz(6)

  @@index([status, occurred_at])
  @@map("face_exception")
}

/// One person's attempt at a tablet: tries, the head-turn challenge, who was identified. See face/INTEGRATION.md §2.
model PunchSession {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id           String              @db.Uuid
  purpose           PunchSessionPurpose @default(PUNCH)
  status            PunchSessionStatus  @default(ACTIVE)
  tries             Int                 @default(0)
  /// REGISTER: who is registering. PUNCH: who was identified, once identified.
  employee_id       String?             @db.Uuid
  /// A re-registration is bound to the specific one-time HR approval at start.
  face_registration_authorization_id String? @db.Uuid
  face_registration_authorization FaceRegistrationAuthorization? @relation(fields: [face_registration_authorization_id], references: [id], onDelete: Restrict)
  /// createPunchSession state (challenge, identification, failures) — no embeddings
  state             Json
  /// Face crops of failed tries, kept only for a manual request (deleted with gate snapshots)
  crop_keys         String[]            @default([])
  punch_id          String?             @db.Uuid
  face_exception_id String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @updatedAt @db.Timestamptz(6)
  closed_at         DateTime?           @db.Timestamptz(6)
  attempts          PunchAttempt[]

  @@index([site_id, created_at])
  @@index([status, created_at])
  @@map("punch_session")
}

/// HR permits one replacement from any site. Existing templates remain usable until successful capture.
model FaceRegistrationAuthorization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String @db.Uuid
  employee Employee @relation(fields: [employee_id], references: [id])
  status FaceRegistrationAuthorizationStatus @default(APPROVED)
  reason String
  approved_by String
  approved_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  used_at DateTime? @db.Timestamptz(6)
  used_site_id String? @db.Uuid
  used_site Site? @relation(fields: [used_site_id], references: [id], onDelete: Restrict)
  revoked_by String?
  revoked_at DateTime? @db.Timestamptz(6)
  sessions PunchSession[]

  @@index([employee_id, approved_at])
  @@map("face_registration_authorization")
}

/// Every analysed upload (and every "This is not me"), for tuning the thresholds from real punches. No images, no embeddings.
model PunchAttempt {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String              @db.Uuid
  session       PunchSession        @relation(fields: [session_id], references: [id])
  site_id       String              @db.Uuid
  /// Chosen by the tablet per upload and reused on retry: the same id never punches twice
  request_id    String
  purpose       PunchSessionPurpose
  /// IDENTIFIED, NO_MATCH, NOT_LIVE, CHALLENGE_FAILED, NO_FACE, MULTIPLE_FACES, POOR_QUALITY, BUSY, EXPIRED, NOT_ME, REGISTERED, DUPLICATE_FACE…
  outcome       String
  code          String?
  counts_as_try Boolean             @default(false)
  tries_after   Int
  /// Best match (or the person registering)
  employee_id   String?             @db.Uuid
  score         Decimal?            @db.Decimal(9, 6)
  second_score  Decimal?            @db.Decimal(9, 6)
  live_score    Decimal?            @db.Decimal(9, 6)
  yaw_front     Decimal?            @db.Decimal(6, 1)
  yaw_turn      Decimal?            @db.Decimal(6, 1)
  challenge     String?
  quality       Json?
  service_ms    Int?
  /// What happened after an identification: CONFIRMED, NOT_ME, CHANGED_SITE, EXPIRED
  resolution    String?
  /// The reply the tablet got, returned again for a retry with the same request_id
  reply         Json
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?           @updatedAt @db.Timestamptz(6)

  @@unique([session_id, request_id])
  @@index([created_at])
  @@index([site_id, created_at])
  @@map("punch_attempt")
}

/// A person leaving one site for another on the tablet ("Change site"). Travel counts only
/// if they punch in at the named site the same day; HR is shown each one and can change it.
model SiteChange {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String           @db.Uuid
  work_date     DateTime         @db.Date
  from_site_id  String           @db.Uuid
  to_site_id    String           @db.Uuid
  out_punch_id  String           @db.Uuid
  in_punch_id   String?          @db.Uuid
  left_at       DateTime         @db.Timestamptz(6)
  arrived_at    DateTime?        @db.Timestamptz(6)
  /// Minutes between the OUT and the IN at the named site, capped by FACE_TRAVEL_MAX_MIN
  travel_min    Int?
  status        SiteChangeStatus @default(PENDING)
  /// HR's figure, which replaces travel_min when set (HR's decision is final)
  hr_travel_min Int?
  reviewed_by   String?
  reviewed_at   DateTime?        @db.Timestamptz(6)
  review_reason String?
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @updatedAt @db.Timestamptz(6)

  @@index([employee_id, work_date])
  @@index([status, created_at])
  @@map("site_change")
}

/// A site's request to send someone to another site. Recording or approving a
/// request never creates a punch, changes face templates or awards travel pay.
model SiteTransferRequest {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String             @db.Uuid
  employee       Employee           @relation(fields: [employee_id], references: [id])
  from_site_id   String             @db.Uuid
  from_site      Site               @relation("TransferFromSite", fields: [from_site_id], references: [id])
  to_site_id     String             @db.Uuid
  to_site        Site               @relation("TransferToSite", fields: [to_site_id], references: [id])
  departure_date DateTime           @db.Date
  reason         String
  status         SiteTransferStatus @default(PENDING)
  requested_by   String
  requested_at   DateTime           @default(now()) @db.Timestamptz(6)
  decided_by     String?
  decided_at     DateTime?          @db.Timestamptz(6)
  decision_note  String?
  updated_at     DateTime?          @updatedAt @db.Timestamptz(6)

  @@index([from_site_id, requested_at(sort: Desc)])
  @@index([status, requested_at])
  @@map("site_transfer_request")
}

model LeaveRequest {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String      @db.Uuid
  employee      Employee    @relation(fields: [employee_id], references: [id])
  leave_type    String
  from_date     DateTime    @db.Date
  to_date       DateTime    @db.Date
  days          Decimal     @db.Decimal(5, 2)
  reason        String?
  status        LeaveStatus @default(PENDING)
  decided_by    String?
  decided_at    DateTime?   @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?   @db.Timestamptz(6)

  @@index([employee_id, from_date])
  @@index([status])
  @@map("leave_request")
}

/// Days HR adds to or takes from a leave balance — opening balances when leave tracking starts, and corrections. Counted in the month of `date`; a locked month cannot take one.
model LeaveAdjustment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String    @db.Uuid
  employee    Employee  @relation(fields: [employee_id], references: [id])
  leave_type  String
  date        DateTime  @db.Date
  /// Positive adds days, negative takes them away
  days        Decimal   @db.Decimal(6, 2)
  reason      String
  created_by  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@index([employee_id, date])
  @@map("leave_adjustment")
}

/// Not used: balances are worked out month by month from the leave policy, the leave recorded and attendance (see LeaveAdjustment).
model LeaveBalance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String    @db.Uuid
  employee    Employee  @relation(fields: [employee_id], references: [id])
  leave_type  String
  year        Int
  accrued     Decimal   @db.Decimal(6, 2)
  used        Decimal   @db.Decimal(6, 2)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@unique([employee_id, leave_type, year])
  @@map("leave_balance")
}

/// Cached daily aggregates for the dashboard, written nightly and updated on each punch.
model DailyAggregate {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime  @db.Date
  site_id    String?   @db.Uuid
  present    Int       @default(0)
  worked_min Int       @default(0)
  headcount  Int       @default(0)
  late       Int       @default(0)
  data       Json?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  @@unique([date, site_id])
  @@map("daily_aggregate")
}

// ─── Payroll ─────────────────────────────────────────────────────────────────

model PayrollPeriod {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_ym          String             @unique
  pay_group_id       String?            @db.Uuid
  pay_group          PayGroup?          @relation(fields: [pay_group_id], references: [id])
  state              PeriodState        @default(DRAFT)
  steps_submitted    Int[]              @default([])
  step_log           Json               @default("[]")
  /// Set atomically while a run is in flight; a second run is rejected, not queued
  running_job_id     String?            @db.Uuid
  run_at             DateTime?          @db.Timestamptz(6)
  run_by             String?
  locked_at          DateTime?          @db.Timestamptz(6)
  paid_at            DateTime?          @db.Timestamptz(6)
  payment_ref        String?            @unique
  statutory_rates_id String?            @db.Uuid
  statutory_rates    StatutoryRates?    @relation(fields: [statutory_rates_id], references: [id])
  settlement_ids     String[]           @default([])
  totals             Json?
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?          @db.Timestamptz(6)
  exclusions         PayrollExclusion[]
  payslips           Payslip[]
  settlements        Settlement[]

  @@map("payroll_period")
}

model PayrollExclusion {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_id   String        @db.Uuid
  period      PayrollPeriod @relation(fields: [period_id], references: [id])
  employee_id String        @db.Uuid
  employee    Employee      @relation(fields: [employee_id], references: [id])
  reason      String
  /// Set when the person is paid in a later run; until then they stay on the held-back list
  resolved_at DateTime?     @db.Timestamptz(6)
  created_by  String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?     @db.Timestamptz(6)

  @@unique([period_id, employee_id])
  @@map("payroll_exclusion")
}

/// The snapshot. Once its period is LOCKED or PAID it cannot be updated (trigger).
model Payslip {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_id        String        @db.Uuid
  period           PayrollPeriod @relation(fields: [period_id], references: [id])
  employee_id      String        @db.Uuid
  employee         Employee      @relation(fields: [employee_id], references: [id])
  gross            BigInt
  salary_gross     BigInt
  adhoc_earnings   BigInt        @default(0)
  total_deductions BigInt
  reimbursements   BigInt
  net              BigInt
  employer_total   BigInt
  ctc_month        BigInt
  pf_wage          BigInt
  esi_applicable   Boolean
  paid_days        Decimal       @db.Decimal(5, 2)
  lop_days         Decimal       @db.Decimal(5, 2)
  divisor          Int
  /// Frozen context: employee, department, pay group, bank, attendance totals, rules applied
  meta             Json
  computed_at      DateTime      @db.Timestamptz(6)
  engine_version   String
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  lines            PayslipLine[]

  @@unique([period_id, employee_id])
  @@index([period_id])
  @@index([employee_id, period_id])
  @@index([period_id, net(sort: Desc)])
  @@map("payslip")
}

model PayslipLine {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payslip_id      String          @db.Uuid
  payslip         Payslip         @relation(fields: [payslip_id], references: [id], onDelete: Cascade)
  seq             Int
  kind            PayslipLineKind
  code            String
  name            String
  full_amount     BigInt
  amount          BigInt
  is_taxable      Boolean
  counts_as_wages Boolean
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)

  @@index([payslip_id])
  @@map("payslip_line")
}

/// Targets resolve at run time.
model AdhocItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_ym   String
  kind        AdhocKind
  name        String
  amount      BigInt
  is_taxable  Boolean
  target_type AdhocTarget
  target_ids  String[]
  note        String
  created_by  String?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?   @db.Timestamptz(6)

  @@index([period_ym])
  @@map("adhoc_item")
}

model Settlement {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id          String          @db.Uuid
  employee             Employee        @relation(fields: [employee_id], references: [id])
  last_day             DateTime        @db.Date
  period_id            String?         @db.Uuid
  period               PayrollPeriod?  @relation(fields: [period_id], references: [id])
  earnings             Json
  deductions           Json
  total_earnings       BigInt
  total_deductions     BigInt
  net                  BigInt
  clearance            Json            @default("[]")
  /// HR's changes, each with its reason: lines switched off, days changed, lines added, a hold released
  adjustments          Json            @default("{}")
  state                SettlementState @default(OPEN)
  /// For a negative net: WRITE_OFF or PURSUE — a deliberate decision is required
  recoverable_decision String?
  /// Paid outside payroll ({ paid_on, payment_ref, by, at }): recorded in its month's payroll, never in a bank file
  paid_separately      Json?
  paid_at              DateTime?       @db.Timestamptz(6)
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?       @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?       @db.Timestamptz(6)
  held_pay             HeldPay[]

  @@index([employee_id])
  @@map("settlement")
}

enum HeldPayState {
  HELD
  QUEUED
  PAID
  PAID_SEPARATELY
}

/// A salary hold on one person from a payroll month until HR releases it. Months run while it
/// stands are calculated as usual — payslip, PF, ESI, TDS — and kept out of the bank file.
model SalaryHold {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String    @db.Uuid
  employee     Employee  @relation(fields: [employee_id], references: [id])
  from_ym      String
  reason       String
  created_by   String
  released_at  DateTime? @db.Timestamptz(6)
  released_by  String?
  release_note String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  held_pay     HeldPay[]

  @@index([employee_id])
  @@map("salary_hold")
}

/// One held month's net pay and what became of it: held, released into a later payroll
/// (paid in that month's bank file), paid with the F&F, or paid separately. Paid once only.
model HeldPay {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hold_id       String       @db.Uuid
  hold          SalaryHold   @relation(fields: [hold_id], references: [id])
  employee_id   String       @db.Uuid
  employee      Employee     @relation(fields: [employee_id], references: [id])
  /// The month whose salary is held
  period_ym     String
  /// That month's net pay, in paise
  amount        BigInt
  state         HeldPayState @default(HELD)
  /// The payroll month that pays it, once released into payroll or paid with the F&F
  pay_ym        String?
  settlement_id String?      @db.Uuid
  settlement    Settlement?  @relation(fields: [settlement_id], references: [id])
  paid_on       DateTime?    @db.Date
  payment_ref   String?
  released_by   String?
  released_at   DateTime?    @db.Timestamptz(6)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?    @updatedAt @db.Timestamptz(6)

  @@unique([employee_id, period_ym])
  @@index([state])
  @@map("held_pay")
}

model Advance {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String     @db.Uuid
  employee    Employee   @relation(fields: [employee_id], references: [id])
  amount      BigInt
  reason      String
  granted_on  DateTime   @db.Date
  instalment  BigInt
  recovered   BigInt     @default(0)
  status      LoanStatus @default(ACTIVE)
  created_by  String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?  @db.Timestamptz(6)

  @@index([employee_id])
  @@map("advance")
}

model Loan {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String     @db.Uuid
  employee         Employee   @relation(fields: [employee_id], references: [id])
  loan_type        String
  principal        BigInt
  months           Int
  emi              BigInt
  instalments_paid Int        @default(0)
  recovered        BigInt     @default(0)
  started_on       DateTime   @db.Date
  status           LoanStatus @default(ACTIVE)
  created_by       String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?  @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?  @db.Timestamptz(6)

  @@index([employee_id])
  @@map("loan")
}

/// What the recovery cap pushed into the next month.
model RecoveryCarry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String    @db.Uuid
  employee    Employee  @relation(fields: [employee_id], references: [id])
  /// The month the carry is to be taken in
  period_ym   String
  amount      BigInt
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@unique([employee_id, period_ym])
  @@map("recovery_carry")
}

/// INSERT-ONLY (trigger + revoked grants).
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at          DateTime  @default(now()) @db.Timestamptz(6)
  actor       String
  action      String
  entity_type String
  entity_id   String?
  detail      Json      @default("{}")
  ip          String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@index([entity_type, entity_id, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@index([actor, at(sort: Desc)])
  @@map("audit_log")
}
