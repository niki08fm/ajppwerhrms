{
  "name": "ajpwer-workforce",
  "private": true,
  "version": "1.0.0",
  "description": "AJPWER Workforce — attendance, payroll and settlement for AJ Power Engineering",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "backend/shared",
    "face"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ajpwer/backend & npm run dev --workspace=@ajpwer/frontend",
    "dev:backend": "npm run dev --workspace=@ajpwer/backend",
    "dev:frontend": "npm run dev --workspace=@ajpwer/frontend",
    "build": "npm run build --workspace=@ajpwer/backend && npm run build --workspace=@ajpwer/frontend",
    "test": "npm run test --workspace=@ajpwer/backend",
    "test:engines": "npm run test:engines --workspace=@ajpwer/backend",
    "db:migrate": "npm run db:migrate --workspace=@ajpwer/backend",
    "db:deploy": "npm run db:deploy --workspace=@ajpwer/backend",
    "db:seed": "npm run db:seed --workspace=@ajpwer/backend",
    "db:seed:load": "npm run db:seed:load --workspace=@ajpwer/backend",
    "db:reset": "npm run db:reset --workspace=@ajpwer/backend",
    "test:api": "npm run test:api --workspace=@ajpwer/backend",
    "test:e2e": "npm run test:e2e --workspace=@ajpwer/frontend",
    "test:load": "npm run test:load --workspace=@ajpwer/backend",
    "jobs:retention": "npm run jobs:retention --workspace=@ajpwer/backend",
    "start": "npm run start --workspace=@ajpwer/backend"
  },
  "engines": {
    "node": ">=22.9"
  }
}
